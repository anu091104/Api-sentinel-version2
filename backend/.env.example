# Copy this file to .env for local development (docker-compose reads it automatically
# when placed at the repo root; for native/venv runs, export these manually or use
# python-dotenv). None of these are required locally — sensible defaults are used.

# Local default is SQLite. For Postgres (Docker Compose or Render):
# DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
DATABASE_URL=sqlite:///./sentinel.db

# Comma-separated list of allowed frontend origins. "*" is fine for local dev.
# In production, set this to your exact Vercel URL, e.g.:
# CORS_ORIGINS=https://api-sentinel.vercel.app
CORS_ORIGINS=*

SWEEP_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
